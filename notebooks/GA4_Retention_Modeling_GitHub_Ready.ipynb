    "test_means = test_df[selected_features].mean()\n",
    "feature_change = ((test_means / train_means - 1) * 100).sort_values()\n",
    "\n",
    "# 3. Actual and predicted W1 retention by evaluation cohort\n",
    "validation_predictions = pd.DataFrame({\n",
    "    \"cohort_week\": pd.to_datetime(val_df[\"cohort_week\"]).to_numpy(),\n",
    "    \"actual\": np.asarray(y_val, dtype=int),\n",
    "    \"predicted\": np.asarray(val_proba_lgb, dtype=float),\n",
    "    \"dataset\": \"Validation\"\n",
    "})\n",
    "test_predictions = pd.DataFrame({\n",
    "    \"cohort_week\": pd.to_datetime(test_df[\"cohort_week\"]).to_numpy(),\n",
    "    \"actual\": np.asarray(y_test, dtype=int),\n",
    "    \"predicted\": np.asarray(test_proba_lgb, dtype=float),\n",
    "    \"dataset\": \"Test\"\n",
    "})\n",
    "prediction_summary = (\n",
    "    pd.concat([validation_predictions, test_predictions], ignore_index=True)\n",
    "      .groupby([\"cohort_week\", \"dataset\"], as_index=False)\n",
    "      .agg(actual_rate=(\"actual\", \"mean\"), predicted_rate=(\"predicted\", \"mean\"))\n",
    "      .sort_values(\"cohort_week\")\n",
    ")\n",
    "prediction_summary[\"actual_rate\"] *= 100\n",
    "prediction_summary[\"predicted_rate\"] *= 100\n",
    "\n",
    "# Explicit category labels avoid the spurious Dec 14 date tick.\n",
    "evaluation_labels = [\n",
    "    f\"{date:%b %d, %Y}<br>{split}\"\n",
    "    for date, split in zip(\n",
    "        pd.to_datetime(prediction_summary[\"cohort_week\"]),\n",
    "        prediction_summary[\"dataset\"]\n",
    "    )\n",
    "]\n",
    "\n",
    "# 4. Ranking performance: average precision and random baseline\n",
    "performance = pd.DataFrame({\n",
    "    \"dataset\": [\"Validation\", \"Test\"],\n",
    "    \"AP\": [\n",
    "        average_precision_score(y_val, val_proba_lgb),\n",
    "        average_precision_score(y_test, test_proba_lgb)\n",
    "    ],\n",
    "    \"baseline\": [\n",
    "        np.asarray(y_val, dtype=int).mean(),\n",
    "        np.asarray(y_test, dtype=int).mean()\n",
    "    ]\n",
    "})\n",
    "\n",
    "# 5. Build four independent, fluid-width charts (instead of one 1250px figure)\n",
    "COLORS = {\n",
    "    \"retention\": \"#5367FF\", \"drift\": \"#F0523B\",\n",
    "    \"actual\": \"#00BFA5\", \"predicted\": \"#A259FF\",\n",
    "    \"ap\": \"#FF9E57\", \"baseline\": \"#23C6E6\"\n",
    "}\n",
    "\n",
    "fig_retention = go.Figure(go.Scatter(\n",
    "    x=cohort[\"cohort_week\"], y=cohort[\"retention_pct\"],\n",
    "    mode=\"lines+markers\", line=dict(color=COLORS[\"retention\"], width=2.5),\n",
    "    marker=dict(size=7), name=\"W1 Retention\",\n",
    "    hovertemplate=\"Cohort: %{x|%Y-%m-%d}<br>W1 return: %{y:.2f}%<extra></extra>\"\n",
    "))\n",
    "fig_retention.update_yaxes(title=\"W1 Retention (%)\", rangemode=\"tozero\")\n",
    "fig_retention.update_xaxes(tickformat=\"%b %d<br>%Y\")\n",
    "\n",
    "fig_drift = go.Figure(go.Bar(\n",
    "    x=feature_change.values, y=feature_change.index,\n",
    "    orientation=\"h\", name=\"Change (%)\",\n",
    "    marker_color=COLORS[\"drift\"],\n",
    "    hovertemplate=\"%{y}<br>Test vs train: %{x:+.2f}%<extra></extra>\"\n",
    "))\n",
    "fig_drift.update_xaxes(title=\"Test vs Train Change (%)\", zeroline=True)\n",
    "fig_drift.update_yaxes(automargin=True)\n",
    "\n",
    "fig_calibration = go.Figure()\n",
    "fig_calibration.add_bar(\n",
    "    x=evaluation_labels, y=prediction_summary[\"actual_rate\"],\n",
    "    name=\"Actual Retention\", marker_color=COLORS[\"actual\"],\n",
    "    hovertemplate=\"%{x}<br>Actual: %{y:.2f}%<extra></extra>\"\n",
    ")\n",
    "fig_calibration.add_bar(\n",
    "    x=evaluation_labels, y=prediction_summary[\"predicted_rate\"],\n",
    "    name=\"Mean Predicted Retention\", marker_color=COLORS[\"predicted\"],\n",
    "    hovertemplate=\"%{x}<br>Predicted: %{y:.2f}%<extra></extra>\"\n",
    ")\n",
    "fig_calibration.update_layout(barmode=\"group\")\n",
    "fig_calibration.update_xaxes(\n",
    "    type=\"category\", categoryorder=\"array\", categoryarray=evaluation_labels\n",
    ")\n",
    "fig_calibration.update_yaxes(title=\"W1 Retention (%)\", rangemode=\"tozero\")\n",
    "\n",
    "fig_ap = go.Figure()\n",
    "fig_ap.add_bar(\n",
    "    x=performance[\"dataset\"], y=performance[\"AP\"],\n",
    "    name=\"LightGBM AP\", marker_color=COLORS[\"ap\"],\n",
    "    hovertemplate=\"%{x}<br>AP: %{y:.4f}<extra></extra>\"\n",
    ")\n",
    "fig_ap.add_bar(\n",
    "    x=performance[\"dataset\"], y=performance[\"baseline\"],\n",
    "    name=\"Random Baseline\", marker_color=COLORS[\"baseline\"],\n",
    "    hovertemplate=\"%{x}<br>Baseline: %{y:.4f}<extra></extra>\"\n",
    ")\n",
    "fig_ap.update_layout(barmode=\"group\")\n",
    "fig_ap.update_yaxes(title=\"Average Precision\", rangemode=\"tozero\")\n",
    "fig_ap.update_xaxes(type=\"category\")\n",
    "\n",
    "charts = [\n",
    "    (\"Weekly Cohort Retention\", fig_retention),\n",
    "    (\"Behavior Feature Drift\", fig_drift),\n",
    "    (\"Actual vs Predicted Retention\", fig_calibration),\n",
    "    (\"Model Average Precision\", fig_ap)\n",
    "]\n",
    "\n",
    "config = {\"responsive\": True, \"displaylogo\": False}\n",
    "cards = []\n",
    "for index, (heading, figure) in enumerate(charts):\n",
    "    figure.update_layout(\n",
    "        template=\"plotly_white\", autosize=True, height=410,\n",
    "        margin=dict(l=42 if index != 1 else 25, r=18, t=24, b=64),\n",
    "        legend=dict(orientation=\"h\", y=-0.27, x=0.5, xanchor=\"center\"),\n",
    "        font=dict(family=\"Arial, sans-serif\", size=12),\n",
    "        showlegend=index in (2, 3)\n",
    "    )\n",
    "    plot_html = pio.to_html(\n",
    "        figure,\n",
    "        full_html=False,\n",
    "        # Embed Plotly only once. The final HTML works offline.\n",
    "        include_plotlyjs=True if index == 0 else False,\n",
    "        config=config,\n",
    "        default_width=\"100%\",\n",
    "        default_height=\"410px\"\n",
    "    )\n",
    "    cards.append(\n",
    "        '<section class=\"chart-card\">'\n",
    "        f'<h2>{heading}</h2>{plot_html}</section>'\n",
    "    )\n",
    "\n",
    "# 6. Responsive 2-column desktop / 1-column narrow-screen page\n",
    "output_file = Path(\"GA4_Model_Monitoring_Dashboard.html\")\n",
    "html = \"\"\"<!doctype html>\n",
    "<html lang=\"en\">\n",
    "<head>\n",
    "  <meta charset=\"utf-8\">\n",
    "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n",
    "  <title>GA4 E-commerce Analytics | Model Monitoring Dashboard</title>\n",
    "  <style>\n",
    "    * { box-sizing: border-box; }\n",
    "    html, body { margin: 0; padding: 0; width: 100%; overflow-x: hidden; }\n",
    "    body { background: #f5f7fb; color: #203455; font-family: Arial, sans-serif; }\n",
    "    .container { width: min(100%, 1520px); margin: 0 auto; padding: 26px 20px 30px; }\n",
    "    header { text-align: center; padding: 5px 0 25px; }\n",
    "    header h1 { margin: 0 0 5px; font-size: clamp(21px, 2.5vw, 30px); }\n",
    "    header p { margin: 0; font-size: 15px; color: #54657f; }\n",
    "    .dashboard-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }\n",
    "    .chart-card { min-width: 0; overflow: hidden; background: white; border: 1px solid #e2e8f0;\n",
    "                  border-radius: 12px; padding: 12px 10px 2px; box-shadow: 0 3px 12px rgba(21,41,70,.04); }\n",
    "    .chart-card h2 { text-align: center; margin: 8px 0 4px; font-size: 17px; font-weight: 600; }\n",
    "    .chart-card .plotly-graph-div { max-width: 100%; }\n",
    "    footer { font-size: 12px; color: #6a778b; text-align: center; padding-top: 23px; line-height: 1.6; }\n",
    "    @media (max-width: 1050px) {\n",
    "      .dashboard-grid { grid-template-columns: minmax(0, 1fr); }\n",
    "      .container { padding: 16px 10px 25px; }\n",
    "      header { padding-bottom: 15px; }\n",
    "    }\n",
    "  </style>\n",
    "</head>\n",
    "<body>\n",
    "  <main class=\"container\">\n",
    "    <header>\n",
    "      <h1>GA4 E-commerce Analytics</h1>\n",
    "      <p>Retention and Model Monitoring Dashboard</p>\n",
    "    </header>\n",
    "    <div class=\"dashboard-grid\">\n",
    "\"\"\" + \"\\n\".join(cards) + \"\"\"\n",
    "    </div>\n",
    "    <footer>\n",
    "      Historical, obfuscated GA4 sample | Observed W1 return | Static interactive snapshot, not live monitoring\n",
    "    </footer>\n",
    "  </main>\n",
    "</body>\n",
    "</html>\"\"\"\n",
    "output_file.write_text(html, encoding=\"utf-8\")\n",
    "\n",
    "print(\"Responsive dashboard saved:\", output_file.resolve())\n",
    "print(\"File size: {:.2f} MB\".format(output_file.stat().st_size / 1024**2))\n",
    "print(\"Responsive 2-column / 1-column layout generated; no model retraining.\")\n",
    "\n",
    "# Optional: download the HTML from Google Colab.\n",
    "# from google.colab import files\n",
    "# files.download(str(output_file))\n"
   ],
