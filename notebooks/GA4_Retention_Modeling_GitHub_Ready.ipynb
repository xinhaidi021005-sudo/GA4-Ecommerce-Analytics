    "# Key figures for GitHub portfolio\n",
    "figure_names = [\n",
    "    \"ga4_cohort_retention_heatmap.png\",\n",
    "    \"ga4_lightgbm_shap_importance.png\",\n",
    "    \"ga4_lr_vs_lightgbm_pr_curve.png\",\n",
    "    \"ga4_lightgbm_final_test_pr_curve.png\",\n",
    "    \"ga4_probability_calibration.png\",\n",
    "    \"ga4_temporal_calibration_drift.png\",\n",
    "    \"ga4_channel_retention_decomposition.png\"\n",
    "]\n",
    "\n",
    "# Check which figures are available\n",
    "available = []\n",
    "missing = []\n",
    "\n",
    "for name in figure_names:\n",
    "    path = os.path.join(\"/content\", name)\n",
    "\n",
    "    if os.path.isfile(path):\n",
    "        available.append(path)\n",
    "    else:\n",
    "        missing.append(name)\n",
    "\n",
    "print(\"=== Available Figures ===\")\n",
    "for path in available:\n",
    "    print(os.path.basename(path))\n",
    "\n",
    "print(\"\\n=== Missing Figures ===\")\n",
    "for name in missing:\n",
    "    print(name)\n",
