   "source": [
    "\n",
    "# Step 41: GA4 Weekly Cohort Retention Heatmap\n",
    "# Generate a portfolio-ready visualization from BigQuery CSV\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import io\n",
    "from google.colab import files\n",
    "\n",
    "# 1. Upload the cohort retention CSV\n",
    "print(\"Please upload ga4_cohort_retention.csv\")\n",
    "\n",
    "uploaded = files.upload()\n",
    "filename = next(iter(uploaded))\n",
    "\n",
    "df_cohort = pd.read_csv(\n",
    "    io.BytesIO(uploaded[filename])\n",
    ")\n",
    "\n",
    "print(\"\\n=== Data Overview ===\")\n",
    "print(\"Shape:\", df_cohort.shape)\n",
    "print(\"Columns:\", df_cohort.columns.tolist())\n",
    "\n",
    "# 2. Validate required columns\n",
    "required_cols = [\n",
    "    \"cohort_week\",\n",
    "    \"week_number\",\n",
    "    \"retention_rate_pct\"\n",
    "]\n",
    "\n",
    "assert set(required_cols).issubset(df_cohort.columns), (\n",
    "    \"Required columns are missing.\"\n",
    ")\n",
    "\n",
    "# 3. Prepare the weekly retention data\n",
    "df_cohort[\"cohort_week\"] = pd.to_datetime(\n",
    "    df_cohort[\"cohort_week\"]\n",
    ")\n",
    "\n",
    "df_cohort[\"week_number\"] = pd.to_numeric(\n",
    "    df_cohort[\"week_number\"]\n",
    ").astype(int)\n",
    "\n",
    "df_cohort[\"retention_rate_pct\"] = pd.to_numeric(\n",
    "    df_cohort[\"retention_rate_pct\"]\n",
    ")\n",
    "\n",
    "# Each cohort/week should appear only once\n",
    "assert not df_cohort.duplicated(\n",
    "    [\"cohort_week\", \"week_number\"]\n",
    ").any(), \"Duplicate cohort-week records found.\"\n",
    "\n",
    "# 4. Build the cohort retention matrix\n",
    "retention_matrix = df_cohort.pivot(\n",
    "    index=\"cohort_week\",\n",
    "    columns=\"week_number\",\n",
    "    values=\"retention_rate_pct\"\n",
    ")\n",
    "\n",
    "retention_matrix = retention_matrix.sort_index()\n",
    "\n",
    "retention_matrix = retention_matrix.reindex(\n",
    "    columns=[0, 1, 2, 3, 4]\n",
    ")\n",
    "\n",
    "print(\"\\n=== Cohort Retention Matrix ===\")\n",
    "display(retention_matrix.round(2))\n",
    "\n",
    "# 5. Prepare color values\n",
    "# Exclude W0 = 100% from the color scale\n",
    "values = retention_matrix.to_numpy(dtype=float)\n",
    "\n",
    "color_values = values.copy()\n",
    "color_values[:, 0] = np.nan\n",
    "\n",
    "cmap = plt.get_cmap(\"Blues\").copy()\n",
    "cmap.set_bad(\"#e9edf2\")\n",
    "\n",
    "# 6. Create heatmap\n",
    "fig, ax = plt.subplots(figsize=(13, 8))\n",
    "\n",
    "im = ax.imshow(\n",
    "    color_values,\n",
    "    cmap=cmap,\n",
    "    aspect=\"auto\",\n",
    "    vmin=0,\n",
    "    vmax=7\n",
    ")\n",
    "\n",
    "# 7. Add axis labels\n",
    "ax.set_xticks(range(5))\n",
    "ax.set_xticklabels(\n",
    "    [\"W0\", \"W1\", \"W2\", \"W3\", \"W4\"],\n",
    "    fontsize=11\n",
    ")\n",
    "\n",
    "ax.set_yticks(range(len(retention_matrix)))\n",
    "\n",
    "ax.set_yticklabels(\n",
    "    retention_matrix.index.strftime(\"%Y-%m-%d\"),\n",
    "    fontsize=10\n",
    ")\n",
    "\n",
    "# 8. Add percentage labels to each cell\n",
    "for i in range(len(retention_matrix)):\n",
    "    for j in range(5):\n",
    "\n",
    "        value = values[i, j]\n",
    "\n",
    "        if np.isfinite(value):\n",
    "\n",
    "            text_color = (\n",
    "                \"white\"\n",
    "                if j > 0 and value >= 5\n",
    "                else \"#202020\"\n",
    "            )\n",
    "\n",
    "            ax.text(\n",
    "                j,\n",
    "                i,\n",
    "                f\"{value:.2f}%\",\n",
    "                ha=\"center\",\n",
    "                va=\"center\",\n",
    "                fontsize=11,\n",
    "                color=text_color\n",
    "            )\n",
    "\n",
    "# 9. Chart formatting\n",
    "ax.set_title(\n",
    "    \"GA4 E-commerce Weekly Cohort Retention\\n\"\n",
    "    \"November 2020 - January 2021\",\n",
    "    fontsize=17,\n",
    "    fontweight=\"bold\",\n",
    "    pad=22\n",
    ")\n",
    "\n",
    "ax.set_xlabel(\n",
    "    \"Weeks Since First Observed Visit\",\n",
    "    fontsize=12\n",
    ")\n",
    "\n",
    "ax.set_ylabel(\n",
    "    \"First Observed Cohort Week\",\n",
    "    fontsize=12\n",
    ")\n",
    "\n",
    "cbar = fig.colorbar(im, ax=ax)\n",
    "cbar.set_label(\n",
    "    \"Weekly Retention Rate (%)\",\n",
    "    fontsize=11\n",
    ")\n",
    "\n",
    "plt.tight_layout()\n",
    "\n",
    "# 10. Save high-resolution image\n",
    "output_file = \"ga4_cohort_retention_heatmap.png\"\n",
    "\n",
    "plt.savefig(\n",
    "    output_file,\n",
    "    dpi=300,\n",
    "    bbox_inches=\"tight\"\n",
    ")\n",
    "\n",
    "plt.show()\n",
    "\n",
    "print(\"\\nHeatmap generated successfully!\")\n",
    "print(\"Saved as:\", output_file)\n",
    "\n",
    "# 11. Download to Mac\n",
    "files.download(output_file)\n"
   ],
